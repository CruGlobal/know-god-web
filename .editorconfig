# https://editorconfig.org
# Prettier also reads this file, so only set values that match .prettierrc
# and Prettier's defaults (no max_line_length, it would change printWidth).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
